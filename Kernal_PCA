    "def kernel(dataset,sigma):\n",
    "    N=len(dataset)\n",
    "    Xt = dataset.to_numpy()\n",
    "    K_sigma = np.empty([N,N])\n",
    "    \n",
    "    for i in range(0,N):\n",
    "        for j in range(i,N): \n",
    "            k = math.exp((-((Xt[i]-Xt[j]).transpose())@(Xt[i]-Xt[j]))/(2*(sigma**2)))\n",
    "            K_sigma[i,j] = k\n",
    "            K_sigma[j,i] = k\n",
    "            \n",
    "    #Kernel centered = (I−1n)K(I−1n)        \n",
    "    one_n = (1/1000)*np.ones([1000,1000])\n",
    "    I = np.eye(1000)\n",
    "    mat = I - one_n\n",
    "    Kernel_sigma_centered = mat@K_sigma@mat\n",
    "    \n",
    "    eigenvalues_k_sigma, eigenvectors_k_sigma = eig(Kernel_sigma_centered)\n",
    "\n",
    "    index = eigenvalues_k_sigma.argsort()[::-1]   \n",
    "    eigenvalues_k_sigma = eigenvalues_k_sigma[index]\n",
    "    eigenvectors_k_sigma = eigenvectors_k_sigma[:,index]\n",
    "    \n",
    "    eigenvalues_k_sigma_features = eigenvalues_k_sigma[0:2]\n",
    "    eigenvectors_k_sigma_mat = eigenvectors_k_sigma.transpose()[0:2]\n",
    "\n",
    "    eigenvectors_sigma_matrix = np.empty([len(eigenvectors_k_sigma_mat),len(eigenvectors_k_sigma_mat.transpose())])\n",
    "    for i in range(0,len(eigenvalues_k_sigma_features)):\n",
    "        eigenvectors_sigma_matrix[i] = (eigenvectors_k_sigma_mat[i])/((N*abs(eigenvalues_k_sigma_features[i]))**0.5)\n",
    "\n",
    "    return  Kernel_sigma_centered, eigenvectors_sigma_matrix"
   ]
